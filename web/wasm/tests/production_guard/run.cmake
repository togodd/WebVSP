# Run with: cmake -P web/wasm/tests/production_guard/run.cmake
# Creates a unique directory in the current working directory and never removes it.
cmake_minimum_required(VERSION 3.24)
set(fixture "${CMAKE_CURRENT_LIST_DIR}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${CMAKE_CURRENT_BINARY_DIR}/webvsp-guard-test-${nonce}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refusing to use existing path: ${root}")
endif()
file(MAKE_DIRECTORY "${root}")
message(STATUS "Test artifacts: ${root}")

function(configure name expect_success)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${root}/${name}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(expect_success AND NOT result EQUAL 0)
        message(FATAL_ERROR "${name}: expected success, got ${result}\n${out}\n${err}")
    elseif(NOT expect_success)
        if(result EQUAL 0 OR NOT "${out}${err}" MATCHES "WEBVSP_PRODUCTION_BUILD")
            message(FATAL_ERROR "${name}: expected production guard failure, got ${result}\n${out}\n${err}")
        endif()
    endif()
    message(STATUS "PASS ${name}")
endfunction()

configure(normal TRUE -DWEBVSP_PRODUCTION_BUILD=ON)
configure(required_state TRUE -DWEBVSP_PRODUCTION_BUILD=ON -DWEBVSP_TEST_REQUIRED_STATE=ON)
file(READ "${root}/normal/flag-syntax.txt" flag_syntax)
if(flag_syntax STREQUAL "msvc")
    set(define_prefix "/D")
    set(include_flag "/FI\"${root}/forced.h\"")
else()
    set(define_prefix "-D")
    set(include_flag "-include \"${root}/forced.h\"")
endif()
configure(default_off TRUE "-DCMAKE_CXX_FLAGS=${define_prefix}WEBVSP_SCRIPT_GUARD_TEST")
configure(option_parm FALSE -DWEBVSP_PRODUCTION_BUILD=ON -DWEBVSP_PARM_REENTRY_TEST=ON)
configure(option_script FALSE -DWEBVSP_PRODUCTION_BUILD=ON -DWEBVSP_SCRIPT_GUARD_TEST=ON)
# Preseed the result too: a cached successful check must not be trusted.
configure(cache_flags FALSE -DWEBVSP_PRODUCTION_BUILD=ON -DWEBVSP_PRODUCTION_MACROS_CLEAN=1 "-DCMAKE_CXX_FLAGS=${define_prefix}WEBVSP_SCRIPT_GUARD_TEST")
configure(release_flags FALSE -DWEBVSP_PRODUCTION_BUILD=ON -DCMAKE_BUILD_TYPE=Debug "-DCMAKE_CXX_FLAGS_RELEASE=${define_prefix}WEBVSP_PARM_REENTRY_TEST")
file(WRITE "${root}/forced.h" "#define WEBVSP_SCRIPT_GUARD_TEST 0\n")
configure(forced_header FALSE -DWEBVSP_PRODUCTION_BUILD=ON "-DCMAKE_CXX_FLAGS=${include_flag}")
# Reconfigure the same tree across failure, recovery, injection, and recovery.
configure(cache_flags TRUE -DWEBVSP_PRODUCTION_BUILD=ON -DCMAKE_CXX_FLAGS=)
configure(cache_flags FALSE -DWEBVSP_PRODUCTION_BUILD=ON "-DCMAKE_CXX_FLAGS=${define_prefix}WEBVSP_PARM_REENTRY_TEST")
configure(cache_flags TRUE -DWEBVSP_PRODUCTION_BUILD=ON -DCMAKE_CXX_FLAGS=)
# A compiler failure must not be mistaken for a clean macro environment.
if(NOT flag_syntax STREQUAL "msvc")
    configure(cache_flags FALSE -DWEBVSP_PRODUCTION_BUILD=ON -DCMAKE_CXX_FLAGS=-fwebvsp-invalid-test-flag)
    configure(cache_flags TRUE -DWEBVSP_PRODUCTION_BUILD=ON -DCMAKE_CXX_FLAGS=)
endif()

# Check the real source guard diagnostics even when their dependencies are absent.
# A missing include will also make preprocessing fail; only our exact #error counts.
find_program(cxx NAMES c++ g++ clang++)
if(cxx)
    get_filename_component(repo "${fixture}/../../../.." ABSOLUTE)
    foreach(source IN ITEMS "${repo}/src/geom_core/Parm.cpp" "${repo}/web/wasm/engine/engine.cpp")
        foreach(hook IN ITEMS WEBVSP_SCRIPT_GUARD_TEST WEBVSP_PARM_REENTRY_TEST)
            execute_process(COMMAND "${cxx}" -E -DWEBVSP_PRODUCTION_BUILD "-D${hook}" "${source}"
                RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE err)
            if(result EQUAL 0 OR NOT err MATCHES "WebVSP test hooks are forbidden in production")
                message(FATAL_ERROR "Source guard missing: ${source}, ${hook}\n${err}")
            endif()
            execute_process(COMMAND "${cxx}" -E "-D${hook}" "${source}"
                OUTPUT_QUIET ERROR_VARIABLE err)
            if(err MATCHES "WebVSP test hooks are forbidden in production")
                message(FATAL_ERROR "Source guard incorrectly rejects test build: ${source}, ${hook}")
            endif()
            message(STATUS "PASS source guard ${source} ${hook}")
        endforeach()
    endforeach()
else()
    message(STATUS "SKIP source preprocessing: no GCC-compatible c++ driver found")
endif()
