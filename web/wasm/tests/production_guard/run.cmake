# Run from a system temporary directory: cmake -P <repo>/web/wasm/tests/production_guard/run.cmake
# Creates a unique directory in the current working directory and never removes it.
cmake_minimum_required(VERSION 3.24)
set(fixture "${CMAKE_CURRENT_LIST_DIR}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${CMAKE_CURRENT_BINARY_DIR}/webvsp-guard-test-${nonce}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refusing to use existing path: ${root}")
endif()
file(MAKE_DIRECTORY "${root}")
message(STATUS "Test artifacts: ${root}")

# Capture only diagnostics appended by this configure, not an earlier failed probe.
function(configure name expected)
    set(logs "${root}/${name}/CMakeFiles/CMakeConfigureLog.yaml"
             "${root}/${name}/CMakeFiles/CMakeError.log")
    foreach(log IN LISTS logs)
        if(EXISTS "${log}")
            file(SIZE "${log}" "size_${log}")
        else()
            set("size_${log}" 0)
        endif()
    endforeach()
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${root}/${name}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set(diagnostics "${out}\n${err}")
    foreach(log IN LISTS logs)
        if(EXISTS "${log}")
            file(SIZE "${log}" current_size)
            if(current_size LESS "${size_${log}}")
                message(FATAL_ERROR "${name}: configure log unexpectedly truncated: ${log}")
            endif()
            file(READ "${log}" appended OFFSET "${size_${log}}")
            string(APPEND diagnostics "\n${appended}")
        endif()
    endforeach()
    if(expected STREQUAL "success")
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "${name}: expected success, got ${result}\n${diagnostics}")
        endif()
    elseif(expected STREQUAL "macro")
        # GCC prints 'error: #error ...'; Clang prints 'error: ...'. Match an
        # actual error line, not the quoted probe source in the configure log.
        if(result STREQUAL "0" OR NOT diagnostics MATCHES "error: (#error )?WebVSP test hooks are forbidden in production")
            message(FATAL_ERROR "${name}: expected macro diagnostic, got ${result}\n${diagnostics}")
        endif()
    elseif(expected STREQUAL "failure")
        if(result STREQUAL "0" OR NOT "${out}${err}" MATCHES "WEBVSP_PRODUCTION_BUILD")
            message(FATAL_ERROR "${name}: expected production guard failure, got ${result}\n${diagnostics}")
        endif()
    else()
        message(FATAL_ERROR "Unknown expectation: ${expected}")
    endif()
    message(STATUS "PASS ${name}")
endfunction()

configure(normal success -DWEBVSP_PRODUCTION_BUILD=ON)
configure(required_state success -DWEBVSP_PRODUCTION_BUILD=ON -DWEBVSP_TEST_REQUIRED_STATE=ON)
file(READ "${root}/normal/flag-syntax.txt" flag_syntax)
# The compiler metadata is generated by CMake on all supported versions.
file(GLOB compiler_metadata "${root}/normal/CMakeFiles/*/CMakeCXXCompiler.cmake")
list(LENGTH compiler_metadata metadata_count)
if(NOT metadata_count EQUAL 1)
    message(FATAL_ERROR "Cannot uniquely identify configured C++ compiler")
endif()
include("${compiler_metadata}")
set(compiler_info "${CMAKE_CXX_COMPILER_ID};${CMAKE_CXX_COMPILER_FRONTEND_VARIANT};${flag_syntax}")
configure(option_parm failure -DWEBVSP_PRODUCTION_BUILD=ON -DWEBVSP_PARM_REENTRY_TEST=ON)
configure(option_script failure -DWEBVSP_PRODUCTION_BUILD=ON -DWEBVSP_SCRIPT_GUARD_TEST=ON)
configure(option_delete_proxy failure -DWEBVSP_PRODUCTION_BUILD=ON -DWEBVSP_DELETE_GEOM_PROXY_TEST=ON)

# Other frontends, especially MSVC and clang-cl, have different diagnostics and
# quoting rules. Do not claim these compiler-diagnostic cases passed on them.
if(compiler_info MATCHES "^(GNU|Clang|AppleClang);(GNU|);gnu$")
    set(define_prefix "-D")
    set(include_flag "-include \"${root}/forced.h\"")
    configure(default_off success "-DCMAKE_CXX_FLAGS=${define_prefix}WEBVSP_SCRIPT_GUARD_TEST")
    # Preseed the result too: a cached successful check must not be trusted.
    configure(cache_flags macro -DWEBVSP_PRODUCTION_BUILD=ON -DWEBVSP_PRODUCTION_MACROS_CLEAN=1 "-DCMAKE_CXX_FLAGS=${define_prefix}WEBVSP_SCRIPT_GUARD_TEST")
    configure(release_flags macro -DWEBVSP_PRODUCTION_BUILD=ON -DCMAKE_BUILD_TYPE=Debug "-DCMAKE_CXX_FLAGS_RELEASE=${define_prefix}WEBVSP_PARM_REENTRY_TEST")
    configure(delete_proxy_flags macro -DWEBVSP_PRODUCTION_BUILD=ON "-DCMAKE_CXX_FLAGS=${define_prefix}WEBVSP_DELETE_GEOM_PROXY_TEST")
    # Identical forced-include arguments must compile before defining the hook.
    file(WRITE "${root}/forced.h" "/* empty positive control */\n")
    configure(forced_header success -DWEBVSP_PRODUCTION_BUILD=ON "-DCMAKE_CXX_FLAGS=${include_flag}")
    file(WRITE "${root}/forced.h" "#define WEBVSP_SCRIPT_GUARD_TEST 0\n")
    configure(forced_header macro -DWEBVSP_PRODUCTION_BUILD=ON "-DCMAKE_CXX_FLAGS=${include_flag}")
    # Reconfigure the same tree across failure, recovery, injection, and recovery.
    configure(cache_flags success -DWEBVSP_PRODUCTION_BUILD=ON -DCMAKE_CXX_FLAGS=)
    configure(cache_flags macro -DWEBVSP_PRODUCTION_BUILD=ON "-DCMAKE_CXX_FLAGS=${define_prefix}WEBVSP_PARM_REENTRY_TEST")
    configure(cache_flags success -DWEBVSP_PRODUCTION_BUILD=ON -DCMAKE_CXX_FLAGS=)
    # A compiler failure must not be mistaken for a clean macro environment.
    configure(cache_flags failure -DWEBVSP_PRODUCTION_BUILD=ON -DCMAKE_CXX_FLAGS=-fwebvsp-invalid-test-flag)
    configure(cache_flags success -DWEBVSP_PRODUCTION_BUILD=ON -DCMAKE_CXX_FLAGS=)
else()
    message(STATUS "SKIP compiler macro diagnostic cases: unsupported frontend (${compiler_info})")
endif()

# Check the real source guard diagnostics even when their dependencies are absent.
find_program(cxx NAMES c++ g++ clang++)
if(cxx)
    get_filename_component(repo "${fixture}/../../../.." ABSOLUTE)
    foreach(source IN ITEMS "${repo}/src/geom_core/Parm.cpp" "${repo}/web/wasm/engine/engine.cpp" "${repo}/src/geom_core/ScriptMgr.cpp")
        if(source MATCHES "/ScriptMgr.cpp$")
            set(hooks WEBVSP_DELETE_GEOM_PROXY_TEST)
        elseif(source MATCHES "/Parm.cpp$")
            set(hooks WEBVSP_SCRIPT_GUARD_TEST WEBVSP_PARM_REENTRY_TEST)
        else()
            set(hooks WEBVSP_SCRIPT_GUARD_TEST WEBVSP_PARM_REENTRY_TEST WEBVSP_DELETE_GEOM_PROXY_TEST)
        endif()
        foreach(hook IN LISTS hooks)
            execute_process(COMMAND "${cxx}" -E -DWEBVSP_PRODUCTION_BUILD "-D${hook}" "${source}"
                RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE err)
            if(result STREQUAL "0" OR NOT err MATCHES "error: (#error )?WebVSP test hooks are forbidden in production")
                message(FATAL_ERROR "Source guard missing: ${source}, ${hook}\n${err}")
            endif()
            execute_process(COMMAND "${cxx}" -E "-D${hook}" "${source}"
                OUTPUT_QUIET ERROR_VARIABLE err)
            if(err MATCHES "error: (#error )?WebVSP test hooks are forbidden in production")
                message(FATAL_ERROR "Source guard incorrectly rejects test build: ${source}, ${hook}")
            endif()
            message(STATUS "PASS source guard ${source} ${hook}")
        endforeach()
    endforeach()
else()
    message(STATUS "SKIP source preprocessing: no GCC-compatible c++ driver found")
endif()
